root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,py,toml}]
indent_style = space
indent_size = 4

[*.{js,mjs,cjs,css,html,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{kicad_sch,kicad_pcb,kicad_pro,kicad_prl,kicad_sym,kicad_mod,csv}]
indent_style = unset
trim_trailing_whitespace = false
insert_final_newline = unset
