	(text "A resistor can be used on the Prog pin \nto select the charging current limit\nfor a LiPo battery.\nFormula in datasheet: I=1000V/RPROG. \nI = 1000V/1.3k = 769.23mA\n\nThe recommended charging current for Li-ion batteries is \ntypically 0.5C to 1C, where C is the battery capacity.\n  - 0.5C (safer, slower charging)\n  - 1C (maximum recommended)\n\nA 3.7V 2000mAh lithium battery will be used.\n"
		(exclude_from_sim no)
		(at 156.21 92.71 0)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify left)
		)
		(uuid "7355e31e-664f-4899-bca5-34f84f9ca895")
	)
	(text "Power Supply"
		(exclude_from_sim no)
		(at 127.508 21.59 0)
		(effects
			(font
				(size 5 5)
				(thickness 1)
				(bold yes)
			)
		)
		(uuid "c90e971f-b1ba-4e38-94f1-9ba47bf33855")
	)
	(text "Minimum Bypass capacitance:\n1µF for I ≤ 250mA and \n4.7µF for I > 250mA"
		(exclude_from_sim no)
		(at 220.98 79.502 0)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify left)
